# =============================================================================
# TEMPLATE — copy to .env and put YOUR own keys. Never commit .env.
#   cp .env.example .env
# Someone else's keys do not ship in this repo; each developer has a private .env.
# =============================================================================

# --- Local uvicorn only (skip for docker compose — Compose Postgres is automatic) ---
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@127.0.0.1:5432/job_application
# Schema: app runs `alembic upgrade head` on startup. Manual: alembic upgrade head

# Optional: Docker API → your Mac Postgres instead of Compose db
# DOCKER_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@host.docker.internal:5432/YOUR_DB
# then: docker compose stop db && docker compose up -d api --no-deps

# Auth (required) — use your own long random string
JOB_APP_JWT_SECRET=change-me-min-32-chars-long-secret-key

# PDF export (Chrome/Chromium). Docker image sets CV_CHROME_BIN=/usr/bin/chromium.
# CV_CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Default preview: data/output/preview (under JOB_APP_DATA_ROOT)
# CV_PREVIEW_DIR=/absolute/path/to/data/output/preview
# JOB_APP_CHROME_NO_SANDBOX=1
# JOB_APP_DATA_ROOT=data
# RAG_PREPARE_STORAGE=data/storage/rag

# --- Your LLM / parse API keys (required for real features) ---
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
# crew_l7 (default) | notebook (legacy; also needs ALLOW_LEGACY_TAILORING=1)
TAILORING_PIPELINE=crew_l7
ALLOW_LEGACY_TAILORING=1

JOB_APP_CREW_VERBOSE=1
JOB_APP_LLM_TOKEN_LOG=1

# Main brain: profile / RAG fill / cover letter / ATS (CrewAI uses OPENAI_MODEL_NAME)
APP_LLM_MODEL=openai:gpt-4o-mini
# Optional Cursor only if you set APP_LLM_MODEL=cursor:composer-2.5
CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5

LLAMA_CLOUD_API_KEY=
# LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai
# Faster in Docker than downloading local HF embeddings:
EMBED_BACKEND=openai
# OPENAI_EMBED_MODEL=text-embedding-3-small
# EMBED_BACKEND=huggingface
# EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
# RAG_PREPARE_STORAGE=data/rag_storage

# Alternatives via aisuite: cursor:composer-2.5, groq:..., google:...
# APP_LLM_MODEL=groq:llama-3.3-70b-versatile

# HURSH_DOCX_TEMPLATE=/absolute/path/to/hursh_resume_template.docx
