# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@127.0.0.1:5432/job_application
JOB_APP_JWT_SECRET=change-me-min-32-chars-long-secret-key

GROQ_API_KEY=
OPENAI_API_KEY=
# L7 CrewAI resume tailor (required when TAILORING_PIPELINE=crew_l7)
OPENAI_MODEL_NAME=gpt-4o-mini
# crew_l7 (default) | notebook (legacy)
TAILORING_PIPELINE=crew_l7

# Live CrewAI agent logs in uvicorn (Working Agent / Starting Task / tokens). 1=on
JOB_APP_CREW_VERBOSE=1
# Print LLM token summaries to server console. 1=on
JOB_APP_LLM_TOKEN_LOG=1

# Cursor SDK / Agents API: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5
# Default LLM for chat/ATS/cover-letter; crew tailor uses OPENAI_* above.
APP_LLM_MODEL=cursor:composer-2.5

# Fallback when Cursor Agent fails on resume → cv.yml
# CV_YAML_LLM_FALLBACK=groq:openai/gpt-oss-20b
# Alternatives via aisuite: groq:..., openai:..., google:...
# APP_LLM_MODEL=groq:llama-3.3-70b-versatile

# Optional: override Hursh DOCX template path
# HURSH_DOCX_TEMPLATE=/absolute/path/to/hursh_resume_template.docx
